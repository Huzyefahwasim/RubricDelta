# Hash-bound benchmark and generated evidence must have identical bytes on every OS.
/.gitattributes text eol=lf
/data/benchmark/*.json text eol=lf
/data/benchmark/**/*.json text eol=lf
/artifacts/**/*.json text eol=lf
/artifacts/**/*.jsonl text eol=lf
/artifacts/**/*.csv text eol=lf
/artifacts/**/*.md text eol=lf
/artifacts/evaluation/** text eol=lf
/artifacts/representative-trajectories/** text eol=lf
/artifacts/expected-replay-report/** text eol=lf
/prompts/*.md text eol=lf
/artifacts/experiments/** text eol=lf
/data/benchmark/replay/*.json text eol=lf
